<!DOCTYPE html>
<html>
<head>
    <title>Reset Password</title>
</head>

<body>
    <h1>Reset Password</h1>

    <p><%= email %></p>

    <form
        action="/auth/reset-password/<%= userId %>/<%= token %>"
        method="POST"
    >
        <label>New Password</label>

        <input
            type="password"
            name="password"
            required
        />

        <button type="submit">
            Save
        </button>
    </form>
</body>
</html>